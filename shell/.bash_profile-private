# Source user environment
[ -f ~/.bashrc ] && source ~/.bashrc

# Load preferred JAVA_HOME
export JAVA_HOME=$(/usr/libexec/java_home -v 2.1)
export PATH=$JAVA_HOME/bin:$PATH

# Load RVM into shell
[[ -s "$HOME/.rvm/scripts/rvm" ]] && source "$HOME/.rvm/scripts/rvm"

# Load rbenv into shell
[[ -x "$(command -v rbenv)" ]] && eval "$(rbenv init -)"

# Claude Code: use a current bash when installed (macOS ships bash 3.2)
[ -x /opt/homebrew/bin/bash ] && export CLAUDE_CODE_SHELL=/opt/homebrew/bin/bash
